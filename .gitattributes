# Normalize all text to LF in the index and check it out as LF, matching the
# `endOfLine: "lf"` policy in .prettierrc. Without this, core.autocrlf=true
# checks files out as CRLF, which prettier --check then rejects.
* text=auto eol=lf

# Shell scripts must stay LF so they run under git-bash on Windows.
*.sh text eol=lf

# Generated by scripts/sync-agents.mjs — collapsed in diffs, excluded from language stats.
.codex/agents/*.toml linguist-generated=true
.claude/skills/** linguist-generated=true
