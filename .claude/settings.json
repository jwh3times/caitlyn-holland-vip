{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git tag -l:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch --tags -q origin)",
      "Bash(gh auth status)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh project item-list *)",
      "Bash(git fetch -q --tags origin)",
      "Bash(cygpath *)",
      "Bash(gh label list *)",
      "Bash(gh project field-list *)",
      "Bash(git fetch -q origin)",
      "Bash(gh project view *)",
      "Bash(git fetch -q --prune origin)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__cloudflare-api__docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/guard.mjs", "--post"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
